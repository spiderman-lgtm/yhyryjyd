# Get this from: viaSocket dashboard → Integrations → your embed → Install Code
VIASOCKET_EMBED_SECRET=your_embed_secret_here

PORT=3000

# Optional: key for signing the per-user id cookie (defaults to one derived from the embed secret)
# COOKIE_SECRET=
# Optional: where automations are stored (point at a persistent volume in production)
# DATA_DIR=./data
# Optional: allowed webhook hosts for viaSocket flow URLs (comma-separated)
# VIASOCKET_WEBHOOK_HOSTS=sokt.io,viasocket.com
# Optional: how often to check for new jobs, in minutes
# JOB_WATCH_MINUTES=10
