# viaSocket embed (viaSocket -> Integrations -> the embed -> Install Code). Server-side only.
VIASOCKET_ORG_ID=9096
VIASOCKET_PROJECT_ID=projGXC7JJAV
VIASOCKET_EMBED_SECRET=

# Public URL of this app; the viaSocket automations call back to it.
APP_URL=https://dealradar.embarko.app

# Who can open /admin. Comma-separated emails; when empty, the first account created becomes the owner.
ADMIN_EMAILS=

# "Continue with Google" (Google Cloud Console -> Credentials -> OAuth client ID, type Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback. Without these the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional affiliate ids. Without them, Buy Now links go to the store unchanged.
AMAZON_ASSOCIATE_TAG=
CUELINKS_CID=

# Where the JSON database lives. Embarko sets DATA_DIR itself.
# DATA_DIR=./data
