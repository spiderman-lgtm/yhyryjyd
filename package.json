{
  "name": "dealradar",
  "version": "1.0.0",
  "description": "Paste a product link, get the best coupon now or a price-drop alert later",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "HOSTNAME=0.0.0.0 node --max-old-space-size=128 --optimize-for-size .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "check:viasocket": "node viasocket-check.mjs src",
    "build:extension": "rm -f public/dealradar-extension.zip && cd extension && zip -qr -X ../public/dealradar-extension.zip . -x \".*\""
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "framer-motion": "^11.18.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "three": "^0.169.0",
    "viasocket-apps": "^0.7.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "1.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
